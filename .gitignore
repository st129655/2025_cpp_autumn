# Игнорируем скомпилированные бинарники и исполняемые файлы
*.exe
*.out
*.app

# Игнорируем объектные файлы и файлы зависимостей (генерируются при компиляции)
*.o
*.obj
*.d

# Игнорируем статические и динамические библиотеки
*.a
*.lib
*.so
*.dylib
*.dll

# Игнорируем прекомпилированные заголовки
*.gch
*.pch

# Игнорируем файлы кэша и метаданные компиляторов
*.slo
*.lo
*.ilk
*.map
*.exp

# Игнорируем папку сборки (build directory) - часто называется 'build', 'bin', 'obj'
/build/
/bin/
/obj/
/out/

# Игнорируем файлы, сгенерированные IDE (Visual Studio, Xcode, CLion)
.vscode/
.idea/
*.suo
*.user
*.sln
*.vcxproj*
*.filters
x64/
x86/
Debug/
Release/
CMakeSettings.json

# Игнорируем файлы, сгенерированные системой (macOS)
.DS_Store

# Игнорируем резервные копии, созданные редакторами
*~
*.swp
*.swo

# Игнорируем документацию, сгенерированную Doxygen
/docs/generated/

# Игнорируем кэш Sanitizers (например, lsan)
*.lsan